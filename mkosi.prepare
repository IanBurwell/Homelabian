#!/usr/bin/env bash
set -euo pipefail  # Fail on error, unset variables, or failed pipeline steps
set -x  # debug print script commands in build log

# Script run before image build/assembly
# In particular, this generates a the systemd-repart config file to generate the
# swap partition using environment variables for target size

if [[ -z "$SWAP_SIZE" ]]; then
    echo "Warning: SWAP_SIZE not set, skipping swap partition in image" >&2
    exit 0
fi

# Create swap partition conf file
cat <<EOF > mkosi.repart/08-swap.conf
[Partition]
Type=swap
Format=swap
SizeMinBytes=${SWAP_SIZE}
SizeMaxBytes=${SWAP_SIZE}
EOF

chown $MKOSI_UID:$MKOSI_GID mkosi.repart/08-swap.conf