#!/bin/bash
set -euo pipefail  # Fail on error, unset variables, or failed pipeline steps
set -x  # debug print script commands in build log

# This script runs after building and installing everything into the image
# In particular, it sets up the ufw firewall

# Firewall setup
ufw default deny incoming
ufw default allow outgoing
ufw allow in on tailscale0  # Allow all traffic on tailscale interface
ufw allow from 10.0.0.0/24 to any port ssh  # Allow SSH from local network
ufw limit ssh
ufw logging low
ufw enable
